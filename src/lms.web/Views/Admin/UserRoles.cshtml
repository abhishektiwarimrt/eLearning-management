@model UserRolesViewModel
@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">@Model.UserId Roles</h1>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded mb-6">@TempData["Success"]</div>
        }

        <!-- Current Roles -->
        <section class="bg-white shadow-sm rounded-lg p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Current Roles</h2>
            @if (Model.CurrentRoles.Any())
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var role in Model.CurrentRoles)
                    {
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                            @role
                            <form asp-action="RemoveRole" method="post" class="ml-2" style="display:inline;">
                                <input type="hidden" name="userId" value="@Model.UserId" />
                                <input type="hidden" name="role" value="@role" />
                                <button type="submit" class="text-red-500 hover:text-red-700 ml-1">&times;</button>
                            </form>
                        </span>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500">No role assigned!</p>
            }
        </section>

        <!-- Available Roles -->
        <section class="bg-white shadow-sm rounded-lg p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Assign New Role</h2>
            @if (Model.AvailableRoles.Any())
            {
                <div class="space-y-3">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <form asp-action="AssignRole" method="post" class="flex items-center">
                            <input type="hidden" name="userId" value="@Model.UserId" />
                            <input type="hidden" name="role" value="@role" />
                            <span class="text-lg font-medium text-gray-900 mr-3">@role</span>
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                                Assign
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500">N/A</p>
            }
        </section>
    </div>
</div>
