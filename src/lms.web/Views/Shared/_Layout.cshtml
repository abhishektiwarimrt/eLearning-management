<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - lms.web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lms.web.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>
    <header>       
        @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
        @using Microsoft.AspNetCore.Authorization
        @inject IAuthorizationService AuthorizationService

        <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b shadow-lg">
            <div class="container mx-auto px-6 py-4">
                <div class="flex items-center">
                    <!-- LEFT: Logo + main menu -->
                    <div class="flex items-center space-x-8">
                        <!-- Logo -->
                        <a href="/" class="flex items-center text-2xl font-bold text-sky-600">
                            <i class="fas fa-graduation-cap mr-2"></i>
                            <span>LMS</span>
                        </a>

                        <!-- Menus -->
                        <div class="hidden md:flex items-center space-x-6 text-sm font-semibold text-sky-700">
                            <a href="/" class="hover:text-sky-500">Home</a>
                            <a href="/courses" class="hover:text-sky-500">Courses</a>
                            <a href="/instructors" class="hover:text-sky-500">Instructors</a>
                        </div>
                    </div>

                    <!-- CENTER: Search -->
                    <div class="flex-1 flex justify-center">
                        <div class="relative w-full max-w-xl">
                            <input type="text"
                                   placeholder="Search courses..."
                                   class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-200 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-100 text-sm">
                            <i class="fas fa-search absolute left-3 top-2.5 text-gray-400"></i>
                        </div>
                    </div>

                    <!-- RIGHT: User avatar / auth -->
                    <div class="flex items-center space-x-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            string? userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                            bool isInstructor = User.IsInRole("Instructor");
                            bool isAdmin = User.IsInRole("Admin");
                            string initial = (userEmail?.Length > 0 ? userEmail[0].ToString() : "U").ToUpper();

                            <div class="relative" x-data="{ open: false }">
                                <button type="button"
                                        class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-white font-semibold shadow-sm hover:bg-indigo-700"
                                        x-on:click="open = !open">
                                    @initial
                                </button>

                                <div x-cloak
                                     x-show="open"
                                     x-transition
                                     x-on:click.outside="open = false"
                                     class="absolute right-0 mt-3 w-64 rounded-xl bg-white py-2 shadow-2xl ring-1 ring-black/5 z-50">

                                    {{@* Email header *@}}
                                    <div class="px-4 py-2 border-b border-gray-100 mb-1">
                                        <p class="text-xs text-gray-400 truncate">@userEmail</p>
                                    </div>

                                    <a href="/Home" class="block px-4 py-2 text-sm text-gray-800 hover:bg-gray-50">
                                        My learnings
                                    </a>

                                    @* KEY LOGIC: show Dashboard if instructor, Teach on LMS if not *@
                                    @if (isInstructor)
                                    {
                                        <a href="/Instructor/Dashboard"
                                               class="block px-4 py-2 text-sm text-gray-800 hover:bg-gray-50 font-medium">
                                            Instructor dashboard
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Instructor"
                                               class="block px-4 py-2 text-sm text-gray-800 hover:bg-gray-50">
                                            Teach on LMS
                                        </a>
                                    }

                                    @if (isAdmin)
                                    {
                                        <div class="my-1 border-t border-gray-100"></div>
                                        <a href="/Admin" class="block px-4 py-2 text-sm text-indigo-700 hover:bg-indigo-50">
                                            Admin panel
                                        </a>
                                    }

                                    <div class="my-1 border-t border-gray-100"></div>
                                    <a href="/Account/Logout"
                                           class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                        Log out
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="/Account/Login"
                                   class="hidden md:inline-block bg-indigo-600 text-white px-5 py-2 rounded-full hover:bg-indigo-700 text-sm font-semibold">
                                Login
                            </a>
                            <a href="/Account/Register"
                                   class="hidden md:inline-block bg-gradient-to-r from-green-500 to-emerald-600 text-white px-5 py-2 rounded-full hover:shadow-lg text-sm font-semibold">
                                Join free
                            </a>
                        }


                        <!-- Mobile menu button -->
                        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-gray-100 ml-2">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobile-menu" class="md:hidden hidden bg-white border-t shadow-lg">
                <div class="px-6 py-4 space-y-4">
                    <a href="/" class="block py-2 px-4 rounded-lg hover:bg-indigo-50">Home</a>
                    <a href="/courses" class="block py-2 px-4 rounded-lg hover:bg-indigo-50">Courses</a>
                    <a href="/instructors" class="block py-2 px-4 rounded-lg hover:bg-indigo-50">Instructors</a>

                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <div class="pt-4 border-t">
                            <span class="block py-2 px-4 font-semibold text-indigo-600">Admin Panel</span>
                            <a href="/Admin" class="block py-2 px-6 text-sm text-gray-600 hover:bg-indigo-50 rounded-lg ml-4">Dashboard</a>
                            <a href="/Admin/UserRoles" class="block py-2 px-6 text-sm text-gray-600 hover:bg-indigo-50 rounded-lg ml-4">User Roles</a>
                            <a href="/Admin/Courses" class="block py-2 px-6 text-sm text-gray-600 hover:bg-indigo-50 rounded-lg ml-4">Courses</a>
                        </div>
                    }
                </div>
            </div>
        </nav>


    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()         
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - lms.web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    

</body>
</html>
