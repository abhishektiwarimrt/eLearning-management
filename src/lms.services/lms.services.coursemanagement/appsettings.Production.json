{
  "ConnectionStrings": {
    "CourseDatabase": "#{DB_CONNECTION_STRING}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AWS": {
    "S3Bucket": {
      "Name": "#{AWS_S3_BUCKET_NAME}#",
      "Region": "#{AWS_REGION}#"
    },
    "SQS": {
      "QueueUrl": "#{AWS_SQS_QUEUE_URL}#"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "#{SERILOG_LOG_PATH}#",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  }
}