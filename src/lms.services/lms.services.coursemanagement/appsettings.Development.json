{
  "ConnectionStrings": {
    "CourseDatabase": "Server=localhost;Port=5431;Database=coursemanagement;User Id=postgres;Password=postgres;Include Error Detail=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AWS": {
    "S3Bucket": {
      "Name": "lms.courses.content.dev",
      "Region": "us-east-1"
    },
    "SQS": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/324037286794/fileupload-dev"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./Log/log-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  }
}